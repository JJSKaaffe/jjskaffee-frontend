# Copia este archivo como .env.local y llena los valores. .env.local no se sube a GitHub.
#
# Producción (Firebase Hosting): crea además .env.production.local, que tampoco se sube, con
#   VITE_API_URL=https://<url-del-gateway>/api
#   y las mismas VITE_FIREBASE_* de abajo.
# npm run build lo lee y deja esos valores fijos en dist/. Si cambian, hay que recompilar y
# volver a publicar. Pasos completos en docs/despliegue.md.

# Base de la API. En local se deja /api: el proxy de Vite lo manda al backend.
# En producción: https://<url-del-gateway>/api (en .env.production.local)
VITE_API_URL=/api

# Backend local al que el proxy de Vite manda /api (el backend corre con el perfil local)
VITE_BACKEND_LOCAL=http://localhost:8080

# Configuración web de Firebase del proyecto jjskafee.
# Consola de Firebase → Configuración del proyecto → General → Tus apps → app web.
# La API key web de Firebase no es un secreto: identifica el proyecto, no da acceso a los datos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=jjskafee.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jjskafee
VITE_FIREBASE_APP_ID=
